# Plantilla de secretos de Streamlit.
# Copiar a .streamlit/secrets.toml y rellenar. Ese archivo está en .gitignore
# y no debe subirse nunca al repositorio.

# --- Gemini (chat y análisis asistido) ---
YOUR_API_KEY = "tu-api-key-de-gemini"

# --- Supabase: lo que SÍ se despliega ---
SUPABASE_URL = "https://tu-proyecto.supabase.co"
SUPABASE_KEY = "clave-anon"          # solo lectura de lo publicado

# --- Supabase: lo que NO se despliega nunca ---
# Se queda en el equipo de quien publica resultados.
SUPABASE_SERVICE_KEY = "clave-service-role"
# Token personal para administrar el proyecto (API de gestión).
SUPABASE_ACCESS_TOKEN = "sbp_..."

# --- Solo en la máquina que procesa formularios (nunca en un despliegue) ---
# Clave para los seudónimos HMAC de Cuidadores 360. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# OBS360_CLAVE_HMAC = "…"
